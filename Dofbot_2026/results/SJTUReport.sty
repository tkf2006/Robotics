%%------------------ 页眉、页脚与页码 ------------------%%
\setlength{\headheight}{15pt}
\fancypagestyle{reportpages}{
    \fancyhf{}
    \fancyhead[L]{\footnotesize\fangsong 上海交通大学}
    \fancyhead[C]{\footnotesize\fangsong Dofbot 第一次大作业实验报告}
    \fancyhead[R]{\footnotesize\fangsong 机器人学}
    \fancyfoot[C]{\thepage}
    \renewcommand{\headrulewidth}{0.4pt}
    \renewcommand{\footrulewidth}{0pt}
}
\pagestyle{reportpages}
%% 目录首页等采用 plain 样式的页面，也保持相同页眉和页码位置。
\fancypagestyle{plain}{
    \fancyhf{}
    \fancyhead[L]{\footnotesize\fangsong 上海交通大学}
    \fancyhead[C]{\footnotesize\fangsong Dofbot 第一次大作业实验报告}
    \fancyhead[R]{\footnotesize\fangsong 机器人学}
    \fancyfoot[C]{\thepage}
